<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:if test="${empty sessionScope.lang}">
    <c:set var="lang" value="en" scope="session" />
</c:if>
<fmt:setLocale value="${sessionScope.lang}" />
<fmt:setBundle basename="messages" var="msg" />
<!DOCTYPE html>
<html lang="${sessionScope.lang}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>QueLess | Clinic queues</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/style.css">
</head>
<body class="public-portal-page">
<header class="site-header">
    <a class="brand" href="${pageContext.request.contextPath}/">QueLess<span class="brand-dot">.</span></a>
    <nav aria-label="Public navigation">
        <a href="${pageContext.request.contextPath}/"><fmt:message key="nav.home" bundle="${msg}"/></a>
        <a href="${pageContext.request.contextPath}/joinqueue"><fmt:message key="nav.join" bundle="${msg}"/></a>
        <c:if test="${not empty sessionScope.myTicketToken}">
            <a href="${pageContext.request.contextPath}/status?ticket=${sessionScope.myTicketToken}">My ticket</a>
        </c:if>
    </nav>
    <div class="header-extras">
        <div class="lang-switch">
            <a href="${pageContext.request.contextPath}/language?lang=en&amp;returnTo=/index.jsp">EN</a>
            <span>/</span>
            <a href="${pageContext.request.contextPath}/language?lang=tn&amp;returnTo=/index.jsp">TSW</a>
        </div>
        <a class="staff-link" href="${pageContext.request.contextPath}/staff/login">Staff portal</a>
    </div>
</header>
<main class="content portal-content">
